{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Site Read-Only Mode demo",
		"author": "aryanjasala"
	},
	"landingPage": "/wp-admin/tools.php?page=site-read-only-mode",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/aryanjasala/site-read-only-mode",
				"ref": "main"
			},
			"options": {
				"activate": true,
				"targetFolderName": "site-read-only-mode"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; wp_insert_post( array( 'post_title' => 'Spring menu', 'post_status' => 'publish', 'post_content' => '<!-- wp:paragraph --><p>Our spring menu starts on Monday, with three new dishes and a lemon tart.</p><!-- /wp:paragraph -->' ) );"
		}
	]
}
