# The WordPress extension (szepeviktor/phpstan-wordpress) is loaded by phpstan/extension-installer.
parameters:
	level: 6
	paths:
		- axle-read-only-mode.php
		- uninstall.php
		- src
	dynamicConstantNames:
		- AXLE_READ_ONLY_MODE
		- AXLE_READ_ONLY_MODE_REASON
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	ignoreErrors:
		# WordPress passes untyped arrays everywhere (hook arguments, options, REST data).
		- identifier: missingType.iterableValue
